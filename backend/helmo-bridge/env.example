# =========================================================
# HELMO - Variables de entorno de ejemplo
# Módulo: backend/helmo-bridge
# Archivo de referencia sin credenciales reales
# =========================================================

# MongoDB local
LOCAL_MONGO_URL=mongodb://localhost:27017
LOCAL_DB_NAME=helmo_database
LOCAL_COLLECTION_NAME=monolito_lecturas

# MongoDB Atlas (opcional)
ATLAS_MONGO_URL=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
ATLAS_DB_NAME=helmo_database
ATLAS_COLLECTION_NAME=monolito_lecturas

# TTN / The Things Stack
TTN_HOST=mqtt://nam1.cloud.thethings.network:1883
TTN_USERNAME=helmo-ptap-app@ttn
TTN_PASSWORD=REEMPLAZAR_POR_API_KEY
TTN_TOPIC=v3/helmo-ptap-app@ttn/devices/+/up
